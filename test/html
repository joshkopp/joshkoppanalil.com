.tags{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:26px;font:600 14px "Bricolage Grotesque",sans-serif}
.tags span{padding:5px 12px;border:1.5px solid currentColor;border-radius:99px}
.open{display:inline-block;font:700 18px "Bricolage Grotesque",sans-serif;border-bottom:3px solid currentColor;padding-bottom:3px;transition:letter-spacing .25s}
.open:hover{letter-spacing:.04em}
.p1{background:var(--navy)}.p2{background:var(--lemon);color:var(--navy)}.p3{background:var(--cob)}.p4{background:#dfe4f7;color:var(--navy)}
.viz{display:grid;place-items:center;min-height:300px}
.viz svg{width:min(100%,420px);height:auto;overflow:visible}

/* password viz */
.pw{width:min(100%,420px);font-family:"Bricolage Grotesque",sans-serif}
.pw .field{padding:16px 18px;border:2px solid var(--chalk);font-size:26px;letter-spacing:.2em;font-weight:600}
.pw .segs{display:flex;gap:6px;margin:14px 0}
.pw .segs i{flex:1;height:14px;background:rgba(255,255,255,.15)}
.pw .segs i.f{background:var(--lemon)}
.pw small{font-size:15px;opacity:.85}

/* flashcards */
.cards{position:relative;width:min(100%,360px);height:260px}
.cards div{position:absolute;inset:0;background:var(--chalk);color:var(--navy);padding:22px;font:700 24px/1.1 "Bricolage Grotesque",sans-serif;border-radius:4px;box-shadow:0 14px 30px -10px rgba(0,0,10,.5);transition:transform .5s cubic-bezier(.2,.8,.2,1)}
.cards div:nth-child(1){transform:rotate(-9deg)}
.cards div:nth-child(2){transform:rotate(5deg);background:var(--lemon)}
.cards div:nth-child(3){transform:rotate(-1deg)}
.cards small{display:block;font:500 16px/1.3 "Newsreader",serif;margin-top:10px}
.panel:hover .cards div:nth-child(1){transform:rotate(-16deg) translateX(-30px)}
.panel:hover .cards div:nth-child(2){transform:rotate(12deg) translateX(30px)}

.contact{background:var(--navy);min-height:100svh;display:flex;flex-direction:column;justify-content:center;position:relative;padding-block:120px 60px}
.contact h2{font-size:clamp(46px,11vw,180px);margin-bottom:clamp(28px,5vw,60px)}
.contact h2 em{font-style:normal;color:var(--lemon)}
.copy{all:unset;display:block;cursor:pointer;font:700 clamp(22px,4.6vw,64px)/1.15 "Bricolage Grotesque",sans-serif;letter-spacing:-.03em;overflow-wrap:anywhere;border-bottom:2px solid rgba(255,255,255,.2);padding:14px 0;transition:color .2s,padding .25s}
.copy:hover,.copy:focus-visible{color:var(--lemon);padding-left:14px}
.hint{margin-top:16px;font:500 15px "Bricolage Grotesque",sans-serif;opacity:.7}
.hint.done{color:var(--lemon);opacity:1}
footer{background:var(--navy);display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;padding-block:22px 40px;font:500 14px "Bricolage Grotesque",sans-serif;color:#8d93c4}
.acc{width:120px;background:none;border:0;border-bottom:1px solid #3a4088;color:#8d93c4;font:inherit;text-align:center;padding:2px 0}
.acc::placeholder{color:#4a5099}.acc:focus{outline:none;border-color:var(--lemon);color:var(--chalk)}

@media(max-width:760px){
  .bar nav{gap:16px}
  .hero-foot,.about-cols,.panel{grid-template-columns:1fr}
  .hero-foot .meta{justify-self:start;text-align:left}
  .panel{padding-block:84px 32px;gap:10px;align-content:center}
  .viz{min-height:200px}.cards{height:200px}
  .orbit{top:70px}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.orbit{animation:none}*{transition:none!important}}
