<script>
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;

// ----- Hero name: letters decode on load, then their weight follows the pointer -----
(()=>{
  const h=document.getElementById('name'),lns=[...h.querySelectorAll('.ln')],chars=[];
  lns.forEach(ln=>{
    const dot=ln.querySelector('.dt'),txt=[...ln.childNodes].filter(n=>n.nodeType===3).map(n=>n.textContent).join('');
    ln.textContent='';
    [...txt].forEach(c=>{const s=document.createElement('span');s.className='ch';s.textContent=c;s.dataset.c=c;ln.appendChild(s);chars.push(s)});
    if(dot)ln.appendChild(dot);
  });
  const G='01#$%&@*+?';
  if(!reduce)chars.forEach((s,i)=>{
    const end=500+i*85,t0=performance.now();
    const f=()=>{const t=performance.now()-t0;
      if(t>=end){s.textContent=s.dataset.c;return}
      s.textContent=G[Math.floor(Math.random()*G.length)];setTimeout(f,55)};
    f();
  });
  if(reduce)return;
  let px=null,py=null,idle=true,cur=chars.map(()=>0),vis=true;
  new IntersectionObserver(e=>vis=e[0].isIntersecting).observe(h);
  addEventListener('pointermove',e=>{px=e.clientX;py=e.clientY;idle=false},{passive:true});
  const frame=t=>{
    requestAnimationFrame(frame);if(!vis)return;
    const r=h.getBoundingClientRect(),R=r.width*.2;
    let x,y;
    if(idle){x=r.left+r.width*(.5+.55*Math.sin(t/1700));y=r.top+r.height*(.5+.3*Math.sin(t/1100))}
    else{x=px;y=py}
    chars.forEach((s,i)=>{
      const b=s.getBoundingClientRect(),dx=b.left+b.width/2-x,dy=(b.top+b.height/2-y)*.6;
      const k=Math.max(0,1-Math.hypot(dx,dy)/R);
      cur[i]+=(k-cur[i])*.12;
      const v=cur[i];
      s.style.fontVariationSettings=`"wght" ${Math.round(800-v*580)},"wdth" ${Math.round(100-v*22)}`;
    });
  };
  requestAnimationFrame(frame);
})();

// ----- About statement fills in as you scroll -----
(()=>{
  const el=document.getElementById('big'),words=el.textContent.trim().split(/\s+/);
  el.innerHTML=words.map(w=>`<span>${w}</span>`).join(' ');
  const sp=[...el.children];
  const upd=()=>{
    const r=el.getBoundingClientRect(),p=Math.min(1,Math.max(0,(innerHeight*.85-r.top)/(r.height+innerHeight*.35)));
    sp.forEach((s,i)=>s.classList.toggle('on',i/sp.length<p*1.05));
  };
  addEventListener('scroll',upd,{passive:true});addEventListener('resize',upd);upd();
})();

// ----- Austin clock -----
const clk=document.getElementById('clock');
const tickClock=()=>{clk.textContent=new Date().toLocaleTimeString('en-US',{timeZone:'America/Chicago',hour:'numeric',minute:'2-digit'})};
tickClock();setInterval(tickClock,15000);

document.getElementById('year').textContent=new Date().getFullYear();

// ----- Secret access code: type "gam" to enter the back room -----
document.getElementById('acc').addEventListener('input',e=>{
  if(e.target.value.trim().toLowerCase()==='gam')location.href='/casino/';
});

// ----- View counter -----
const OFFSET=359;
fetch('https://joshkopp.goatcounter.com/counter/TOTAL.json').then(r=>r.json()).then(d=>{
  const n=parseInt(String(d.count).replace(/\D/g,''),10)||0;
  document.getElementById('views').textContent=(n+OFFSET).toLocaleString()+' visits';
}).catch(()=>{});

// ----- Click to copy -----
const hint=document.getElementById('hint');let ht;
document.querySelectorAll('.copy').forEach(btn=>btn.addEventListener('click',async()=>{
  const text=btn.dataset.copy;
  try{await navigator.clipboard.writeText(text)}catch(e){
    const t=document.createElement('textarea');t.value=text;document.body.appendChild(t);t.select();document.execCommand('copy');t.remove();
  }
  hint.textContent='Copied '+text;hint.classList.add('done');
  clearTimeout(ht);ht=setTimeout(()=>{hint.textContent='Click either one to copy it.';hint.classList.remove('done')},2000);
}));
</script>
