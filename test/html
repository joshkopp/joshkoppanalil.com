<style>
:root{--cob:#2a3cff;--navy:#0b1046;--chalk:#f1f3f8;--lemon:#ffe63d;--pad:clamp(20px,5vw,72px)}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:70px}
body{margin:0;background:var(--navy);color:var(--chalk);font:400 clamp(17px,1.5vw,20px)/1.6 "Newsreader",Georgia,serif;overflow-x:clip}
a{color:inherit;text-decoration:none}
h1,h2,h3{font-family:"Bricolage Grotesque",sans-serif;margin:0;font-weight:800;line-height:.9;letter-spacing:-.035em}
:focus-visible{outline:3px solid var(--lemon);outline-offset:3px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
section,footer{padding-inline:var(--pad)}

/* top bar */
.bar{position:fixed;inset:0 0 auto;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:16px var(--pad);mix-blend-mode:difference;color:#fff;font:600 15px "Bricolage Grotesque",sans-serif}
.bar nav{display:flex;gap:26px}
.bar a:hover{text-decoration:underline;text-underline-offset:5px}
.logo{font-weight:800;font-size:22px;letter-spacing:-.04em}

/* hero */
.hero{background:var(--cob);color:var(--chalk);min-height:100svh;display:flex;flex-direction:column;justify-content:flex-end;padding-top:110px;padding-bottom:clamp(24px,4vw,56px);position:relative;overflow:hidden}
.hero h1{font-size:16.2vw;line-height:.8;letter-spacing:-.05em;font-variation-settings:"wght" 800,"wdth" 100;cursor:default;user-select:none}
.hero h1 .ln{display:block;white-space:nowrap}
.hero h1 .ch{display:inline-block;font-variation-settings:"wght" 800,"wdth" 100}
.hero h1 .dt{color:var(--lemon)}
.hero-foot{display:grid;grid-template-columns:1.3fr 1fr;gap:30px;align-items:end;margin-top:clamp(28px,5vw,64px)}
.hero-foot p{margin:0;max-width:34em;font-size:clamp(19px,2vw,26px);line-height:1.35}
.hero-foot .meta{justify-self:end;text-align:right;font:500 15px/1.5 "Bricolage Grotesque",sans-serif}
.meta b{display:block;font-size:clamp(28px,4vw,52px);letter-spacing:-.03em;font-weight:700}
.go{display:inline-block;margin-top:22px;padding:14px 26px;background:var(--lemon);color:var(--navy);font:700 16px "Bricolage Grotesque",sans-serif;border-radius:2px;transition:transform .2s,background .2s}
.go:hover{transform:translate(-3px,-3px);box-shadow:5px 5px 0 var(--navy)}
.orbit{position:absolute;top:96px;right:var(--pad);width:clamp(96px,14vw,190px);aspect-ratio:1;animation:spin 22s linear infinite}
.orbit text{font:700 12.5px "Bricolage Grotesque",sans-serif;fill:var(--lemon);letter-spacing:.14em}
@keyframes spin{to{transform:rotate(360deg)}}

/* about */
.about{background:var(--chalk);color:var(--navy);padding-block:clamp(80px,14vw,200px)}
.big{font:700 clamp(34px,6.4vw,96px)/1 "Bricolage Grotesque",sans-serif;letter-spacing:-.04em;margin:0;max-width:17em}
.big span{opacity:.16;transition:opacity .25s}
.big span.on{opacity:1}
.about-cols{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,6vw,100px);margin-top:clamp(48px,8vw,110px);max-width:1100px;margin-left:auto}
.about-cols p{margin:0 0 1em}
.now{background:var(--lemon);padding:22px 24px;align-self:start;font:500 16px/1.4 "Bricolage Grotesque",sans-serif;transform:rotate(-2deg)}
.now b{display:block;font-size:clamp(24px,3vw,36px);line-height:1;margin-top:6px;letter-spacing:-.03em}

/* stacked project panels */
.panel{position:sticky;top:0;min-height:100svh;display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(24px,5vw,80px);align-items:center;padding-block:100px 60px;box-shadow:0 -30px 60px -20px rgba(0,0,0,.35)}
